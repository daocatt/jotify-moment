# PostgreSQL image with the pg_bigm extension preinstalled.
#
# The official postgres:17-alpine image compiles PostgreSQL from source into
# /usr/local and runs `make install-world-bin`, so PGXS and the server headers
# are already present. Only the ICU headers have to be added, because
# PostgreSQL is built --with-icu (see the icu-dev note below).
#
# pg_bigm provides the 2-gram GIN index behind the keyword search in
# src/app/actions/posts.ts (searchPostsAction). Without it that query falls
# back to a sequential scan over posts.content.
FROM postgres:17-alpine

ARG PG_BIGM_VERSION=v1.2-20250903
ARG PG_BIGM_SHA256=4d4fb48161e3f9e99207851299379c83b3e5d1d3c1a07c35f6a3153d577b3142

# icu-dev is required because PostgreSQL is built --with-icu, so the server
# header utils/pg_locale.h does #include <unicode/ucol.h>. The image ships the
# ICU runtime libraries and data (needed to run), but not the headers (needed
# to compile). Omitting it fails the build with
#   fatal error: unicode/ucol.h: No such file or directory
# No other -dev package is needed: the only other external headers the
# extension reaches are libc's. gettext is not required because the image
# builds PostgreSQL without --enable-nls.
#
# with_llvm=no is passed to make because PostgreSQL is built --with-llvm, which
# makes PGXS also emit LLVM bitcode (.bc) alongside the object files, for JIT
# inlining. That step invokes clang, which the base image installs only to
# build PostgreSQL itself and then removes, so the default build fails with
#   make: clang-21: No such file or directory
# The bitcode is optional. Skipping it only means PostgreSQL's JIT cannot
# inline this extension's functions, which does not matter for a GIN operator
# class. with_llvm is a plain variable in PGXS's Makefile.global, so the
# command-line assignment overrides it and drops .bc from the all and install
# targets.
RUN set -eux; \
	apk add --no-cache --virtual .build-deps \
		build-base \
		curl \
		icu-dev \
	; \
	curl -fsSL "https://github.com/pgbigm/pg_bigm/archive/refs/tags/${PG_BIGM_VERSION}.tar.gz" -o /tmp/pg_bigm.tar.gz; \
	echo "${PG_BIGM_SHA256}  /tmp/pg_bigm.tar.gz" | sha256sum -c -; \
	tar xzf /tmp/pg_bigm.tar.gz -C /tmp; \
	cd /tmp/pg_bigm-*; \
	make USE_PGXS=1 PG_CONFIG=/usr/local/bin/pg_config with_llvm=no; \
	make USE_PGXS=1 PG_CONFIG=/usr/local/bin/pg_config with_llvm=no install; \
	cd /; \
	rm -rf /tmp/pg_bigm*; \
	apk del --no-network .build-deps
